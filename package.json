{
  "name": "nexus",
  "private": true,
  "version": "0.0.0",
  "description": "Modular monorepo for the Nexus agentic engineering platform",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "pnpm --filter @nexus/web lint",
    "format": "echo \"TypeScript format deferred to package tooling\"",
    "typecheck": "pnpm --filter @nexus/web typecheck",
    "test": "pnpm --filter @nexus/web test",
    "build": "pnpm --filter @nexus/web build",
    "dev:web": "pnpm --filter @nexus/web dev"
  }
}
