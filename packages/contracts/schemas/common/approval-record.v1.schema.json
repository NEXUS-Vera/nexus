{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/schemas/common/approval-record.v1.schema.json",
  "title": "ApprovalRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "status": {
      "type": "string",
      "enum": [
        "not-required",
        "proposed",
        "awaiting-user",
        "user-approved",
        "agent-decided",
        "rejected"
      ]
    },
    "decidedBy": {
      "$ref": "https://nexus.local/schemas/common/actor-reference.v1.schema.json"
    },
    "decidedAt": {
      "type": "string",
      "format": "date-time"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  }
}

