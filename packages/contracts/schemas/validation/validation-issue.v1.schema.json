{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/schemas/validation/validation-issue.v1.schema.json",
  "title": "ValidationIssue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "issueId",
    "projectId",
    "severity",
    "code",
    "message",
    "blocking",
    "resolutionType",
    "createdAt",
    "resolutionStatus"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "issueId": { "type": "string", "pattern": "^issue_[A-Za-z0-9]{16,}$" },
    "projectId": { "type": "string", "pattern": "^proj_[A-Za-z0-9]{16,}$" },
    "severity": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low", "info"]
    },
    "code": { "type": "string", "minLength": 1 },
    "message": { "type": "string", "minLength": 1 },
    "artifactId": { "type": "string", "pattern": "^art_[A-Za-z0-9]{16,}$" },
    "itemId": { "type": "string", "minLength": 1 },
    "blocking": { "type": "boolean" },
    "resolutionType": {
      "type": "string",
      "enum": [
        "user-input",
        "artifact-regeneration",
        "manual-review",
        "automatic-fix",
        "not-applicable"
      ]
    },
    "suggestedResolution": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "resolvedAt": { "type": "string", "format": "date-time" },
    "resolutionStatus": { "type": "string", "enum": ["open", "resolved"] }
  }
}

