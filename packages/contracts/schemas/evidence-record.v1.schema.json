{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/schemas/evidence-record.v1.schema.json",
  "title": "EvidenceRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "evidenceId", "sourceAgent", "provenance"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "evidenceId": {
      "type": "string",
      "minLength": 1
    },
    "sourceAgent": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["tool", "retrieval", "human", "model", "system"]
        },
        "reference": {
          "type": "string"
        },
        "collectedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "summary": {
      "type": "string"
    }
  }
}
