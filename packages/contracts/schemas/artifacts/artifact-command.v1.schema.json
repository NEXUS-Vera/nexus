        "projectId": {
          "type": "string",
          "pattern": "^proj_[A-Za-z0-9]{16,}$"
        },
        "artifactId": {
          "type": "string",
          "pattern": "^art_[A-Za-z0-9]{16,}$"
        },
        "workspaceId": {
          "type": "string",
          "pattern": "^ws_[A-Za-z0-9]{16,}$"
        },
        "baseArtifactVersion": {
          "type": "integer",
          "minimum": 1
        },
        "baseProjectStateVersion": {
          "type": "integer",
          "minimum": 1
        },
        "requestedBy": {
          "$ref": "https://nexus.local/schemas/common/actor-reference.v1.schema.json"
        },
        "requestedAt": {
          "type": "string",
          "format": "date-time"
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "entityType",
            "entityId"
          ],
          "properties": {
            "entityType": {
              "type": "string",
              "enum": ["functional-node"]
            },
            "entityId": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  ]
}
