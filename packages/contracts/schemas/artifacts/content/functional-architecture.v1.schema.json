{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/schemas/artifacts/content/functional-architecture.v1.schema.json",
  "title": "FunctionalArchitectureContent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "architectureId",
    "architectureMaturity",
    "systemBoundary",
    "nodes",
    "edges",
    "assumptions",
    "unresolvedDecisions",
    "requirementCoverage"
  ],
  "properties": {
    "architectureId": { "type": "string", "pattern": "^arch_[A-Za-z0-9]{16,}$" },
    "architectureMaturity": { "type": "string", "const": "functional" },
    "systemBoundary": { "type": "string", "minLength": 1 },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["nodeId", "name", "functionalType", "responsibilities", "satisfiesRequirementIds"],
        "properties": {
          "nodeId": { "type": "string", "pattern": "^node_[A-Za-z0-9]{16,}$" },
          "name": { "type": "string", "minLength": 1 },
          "functionalType": {
            "type": "string",
            "enum": [
              "input",
              "sensing",
              "processing",
              "control",
              "storage",
              "communication",
              "power",
              "output",
              "actuation",
              "analysis",
              "user-interface",
              "external-system"
            ]
          },
          "responsibilities": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "satisfiesRequirementIds": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^req_[A-Za-z0-9]{16,}$" }
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["dataType", "description"],
              "properties": {
                "dataType": { "type": "string", "minLength": 1 },
                "description": { "type": "string", "minLength": 1 }
              }
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["dataType", "description"],
              "properties": {
                "dataType": { "type": "string", "minLength": 1 },
                "description": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["edgeId", "fromNodeId", "toNodeId", "flowType", "description"],
        "properties": {
          "edgeId": { "type": "string", "pattern": "^edge_[A-Za-z0-9]{16,}$" },
          "fromNodeId": { "type": "string", "pattern": "^node_[A-Za-z0-9]{16,}$" },
          "toNodeId": { "type": "string", "pattern": "^node_[A-Za-z0-9]{16,}$" },
          "flowType": {
            "type": "string",
            "enum": ["data", "control", "power", "user-input", "physical-output"]
          },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assumptionId", "statement", "sourceType", "confidence", "confirmationStatus"],
        "properties": {
          "assumptionId": { "type": "string", "minLength": 1 },
          "statement": { "type": "string", "minLength": 1 },
          "sourceType": {
            "type": "string",
            "enum": ["user-explicit", "user-implied", "system-inferred", "project-policy"]
          },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
          "confirmationStatus": {
            "type": "string",
            "enum": ["confirmed", "proposed", "needs-confirmation", "rejected"]
          }
        }
      }
    },
    "unresolvedDecisions": {
      "type": "array",
      "items": { "$ref": "https://nexus.local/schemas/common/open-question-reference.v1.schema.json" }
    },
    "requirementCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coveredRequirementIds"],
      "properties": {
        "coveredRequirementIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^req_[A-Za-z0-9]{16,}$" }
        }
      }
    }
  }
}

