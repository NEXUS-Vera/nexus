{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/schemas/artifacts/content/project-brief.v1.schema.json",
  "title": "ProjectBriefContent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "goal",
    "problemStatement",
    "intendedContext",
    "projectStage",
    "scope",
    "outOfScope",
    "successCriteria",
    "assumptions",
    "unknowns"
  ],
  "properties": {
    "goal": { "type": "string", "minLength": 1 },
    "problemStatement": { "type": "string", "minLength": 1 },
    "intendedContext": { "type": "string", "minLength": 1 },
    "projectStage": { "type": "string", "enum": ["concept", "prototype-planning"] },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "outOfScope": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "successCriteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assumptionId", "statement", "sourceType", "confidence", "confirmationStatus"],
        "properties": {
          "assumptionId": { "type": "string", "minLength": 1 },
          "statement": { "type": "string", "minLength": 1 },
          "sourceType": {
            "type": "string",
            "enum": ["user-explicit", "user-implied", "system-inferred", "project-policy"]
          },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
          "confirmationStatus": {
            "type": "string",
            "enum": ["confirmed", "proposed", "needs-confirmation", "rejected"]
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": { "$ref": "https://nexus.local/schemas/common/open-question-reference.v1.schema.json" }
    }
  }
}

