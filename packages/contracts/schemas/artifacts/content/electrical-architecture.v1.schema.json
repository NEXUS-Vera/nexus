{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/schemas/artifacts/content/electrical-architecture.v1.schema.json",
  "title": "ElectricalArchitectureContent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "architectureId",
    "maturity",
    "summary",
    "nodes",
    "connections",
    "powerDomains",
    "assumptions",
    "unresolvedDecisions",
    "warnings",
    "coverageSummary",
    "evidenceStatus",
    "selectionBasisSummary"
  ],
  "properties": {
    "architectureId": {
      "type": "string",
      "pattern": "^earch_[A-Za-z0-9]{16,}$"
    },
    "maturity": {
      "type": "string",
      "enum": ["provisional", "drafted", "reviewed", "approved"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nodeId",
          "name",
          "nodeType",
          "functionalArchitectureNodeIds",
          "componentRoleIds",
          "implementationStatus",
          "evidenceStatus"
        ],
        "properties": {
          "nodeId": {
            "type": "string",
            "pattern": "^enode_[A-Za-z0-9]{16,}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "nodeType": {
            "type": "string",
            "enum": [
              "component",
              "power-source",
              "power-regulator",
              "connector",
              "protection",
              "supporting-electronics",
              "external-interface",
              "junction"
            ]
          },
          "functionalArchitectureNodeIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "componentRoleIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "implementationStatus": {
            "type": "string",
            "enum": [
              "unresolved",
              "preferred",
              "approved",
              "provisional",
              "unsupported"
            ]
          },
          "evidenceStatus": {
            "$ref": "https://nexus.local/schemas/common/artifact-status.v1.schema.json#/$defs/evidenceStatus"
          },
          "componentCandidateId": {
            "type": "string",
            "minLength": 1
          },
          "selectionState": {
            "type": "string",
            "enum": ["preferred", "approved", "unresolved", "none"]
          },
          "interfaces": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "interfaceId",
                "interfaceType",
                "direction",
                "status"
              ],
              "properties": {
                "interfaceId": {
                  "type": "string",
                  "pattern": "^eiface_[A-Za-z0-9]{16,}$"
                },
                "interfaceType": {
                  "type": "string",
                  "enum": [
                    "analog",
                    "gpio",
                    "i2c",
                    "spi",
                    "uart",
                    "can",
                    "usb",
                    "ethernet",
                    "pwm",
                    "power",
                    "ground",
                    "other",
                    "unknown"
                  ]
                },
                "direction": {
                  "type": "string",
                  "enum": ["in", "out", "bidirectional", "unknown"]
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "resolved",
                    "unresolved",
                    "unknown",
                    "needs-resolution"
                  ]
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "voltage": {
                  "$ref": "https://nexus.local/schemas/common/quantity.v1.schema.json"
                },
                "notes": {
                  "type": "string",
                  "minLength": 1
                },
                "provenance": {
                  "$ref": "https://nexus.local/schemas/common/derived-fact-provenance.v1.schema.json"
                }
              }
            }
          },
          "requirementIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "notes": {
            "type": "string",
            "minLength": 1
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "connectionId",
          "fromNodeId",
          "toNodeId",
          "connectionType",
          "interfaceType",
          "status"
        ],
        "properties": {
          "connectionId": {
            "type": "string",
            "pattern": "^econn_[A-Za-z0-9]{16,}$"
          },
          "fromNodeId": {
            "type": "string",
            "pattern": "^enode_[A-Za-z0-9]{16,}$"
          },
          "toNodeId": {
            "type": "string",
            "pattern": "^enode_[A-Za-z0-9]{16,}$"
          },
          "connectionType": {
            "type": "string",
            "enum": [
              "signal",
              "bus",
              "power",
              "ground",
              "communication",
              "control",
              "other"
            ]
          },
          "interfaceType": {
            "type": "string",
            "enum": [
              "analog",
              "gpio",
              "i2c",
              "spi",
              "uart",
              "can",
              "usb",
              "ethernet",
              "pwm",
              "power",
              "ground",
              "other",
              "unknown"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "resolved",
              "provisional",
              "unresolved",
              "needs-resolution"
            ]
          },
          "fromInterfaceId": {
            "type": "string",
            "pattern": "^eiface_[A-Za-z0-9]{16,}$"
          },
          "toInterfaceId": {
            "type": "string",
            "pattern": "^eiface_[A-Za-z0-9]{16,}$"
          },
          "functionalArchitectureEdgeIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "provisionalReason": {
            "type": "string",
            "minLength": 1
          },
          "provenance": {
            "$ref": "https://nexus.local/schemas/common/derived-fact-provenance.v1.schema.json"
          }
        }
      }
    },
    "powerDomains": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["powerDomainId", "name", "status"],
        "properties": {
          "powerDomainId": {
            "type": "string",
            "pattern": "^epwr_[A-Za-z0-9]{16,}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": ["known", "unknown", "needs-resolution"]
          },
          "nominalVoltage": {
            "$ref": "https://nexus.local/schemas/common/quantity.v1.schema.json"
          },
          "memberNodeIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^enode_[A-Za-z0-9]{16,}$"
            }
          },
          "notes": {
            "type": "string",
            "minLength": 1
          },
          "provenance": {
            "$ref": "https://nexus.local/schemas/common/derived-fact-provenance.v1.schema.json"
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assumptionId",
          "statement",
          "sourceType",
          "confidence",
          "confirmationStatus"
        ],
        "properties": {
          "assumptionId": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "sourceType": {
            "type": "string",
            "enum": [
              "user-explicit",
              "user-implied",
              "system-inferred",
              "project-policy"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "confirmationStatus": {
            "type": "string",
            "enum": [
              "confirmed",
              "proposed",
              "needs-confirmation",
              "rejected"
            ]
          }
        }
      }
    },
    "unresolvedDecisions": {
      "type": "array",
      "items": {
        "$ref": "https://nexus.local/schemas/common/open-question-reference.v1.schema.json"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "severity"],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": ["info", "warning", "blocking"]
          },
          "relatedNodeIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^enode_[A-Za-z0-9]{16,}$"
            }
          }
        }
      }
    },
    "coverageSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totalFunctionalNodes",
        "coveredFunctionalNodes",
        "uncoveredFunctionalNodeIds",
        "preferredImplementationCount",
        "approvedImplementationCount",
        "unresolvedImplementationCount",
        "unresolvedConnectionCount"
      ],
      "properties": {
        "totalFunctionalNodes": {
          "type": "integer",
          "minimum": 0
        },
        "coveredFunctionalNodes": {
          "type": "integer",
          "minimum": 0
        },
        "uncoveredFunctionalNodeIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "preferredImplementationCount": {
          "type": "integer",
          "minimum": 0
        },
        "approvedImplementationCount": {
          "type": "integer",
          "minimum": 0
        },
        "unresolvedImplementationCount": {
          "type": "integer",
          "minimum": 0
        },
        "unresolvedConnectionCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "evidenceStatus": {
      "$ref": "https://nexus.local/schemas/common/artifact-status.v1.schema.json#/$defs/evidenceStatus"
    },
    "selectionBasisSummary": {
      "type": "string",
      "minLength": 1
    }
  }
}
