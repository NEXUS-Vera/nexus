{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/schemas/project/project.v1.schema.json",
  "title": "Project",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "title",
    "domain",
    "projectPhase",
    "currentStateVersion",
    "autonomyMode",
    "currentArtifactReferences",
    "openQuestionReferences",
    "blockerOrValidationIssueReferences",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "projectId": {
      "type": "string",
      "pattern": "^proj_[A-Za-z0-9]{16,}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "const": "embedded-products"
    },
    "projectPhase": {
      "type": "string",
      "enum": [
        "concept",
        "prototype-planning"
      ]
    },
    "currentStateVersion": {
      "type": "integer",
      "minimum": 1
    },
    "autonomyMode": {
      "type": "string",
      "enum": [
        "collaborate",
        "delegate"
      ]
    },
    "currentArtifactReferences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifactType",
          "artifactId",
          "artifactVersion",
          "contentSchemaVersion"
        ],
        "properties": {
          "artifactType": {
            "$ref": "https://nexus.local/schemas/common/artifact-type.v1.schema.json"
          },
          "artifactId": {
            "type": "string",
            "pattern": "^art_[A-Za-z0-9]{16,}$"
          },
          "artifactVersion": {
            "type": "integer",
            "minimum": 1
          },
          "contentSchemaVersion": {
            "type": "string",
            "const": "1.0.0"
          }
        }
      }
    },
    "openQuestionReferences": {
      "type": "array",
      "items": {
        "$ref": "https://nexus.local/schemas/common/open-question-reference.v1.schema.json"
      }
    },
    "blockerOrValidationIssueReferences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issueId"
        ],
        "properties": {
          "issueId": {
            "type": "string",
            "pattern": "^issue_[A-Za-z0-9]{16,}$"
          }
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
