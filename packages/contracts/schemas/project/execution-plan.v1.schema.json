{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/schemas/project/execution-plan.v1.schema.json",
  "title": "ExecutionPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "basisProjectStateVersion",
    "sourceArtifacts",
    "requirements",
    "assumptions",
    "components",
    "interfaces",
    "openDecisionIds",
    "workspaces",
    "verificationObjectives",
    "steps"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0",
      "type": "string"
    },
    "status": {
      "const": "proposed",
      "type": "string"
    },
    "basisProjectStateVersion": {
      "type": "integer",
      "minimum": 1
    },
    "sourceArtifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifactId",
          "artifactVersion"
        ],
        "properties": {
          "artifactId": {
            "type": "string",
            "minLength": 1
          },
          "artifactVersion": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "minItems": 1
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifactId",
          "entityId"
        ],
        "properties": {
          "artifactId": {
            "type": "string",
            "minLength": 1
          },
          "entityId": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifactId",
          "entityId"
        ],
        "properties": {
          "artifactId": {
            "type": "string",
            "minLength": 1
          },
          "entityId": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifactId",
          "entityId"
        ],
        "properties": {
          "artifactId": {
            "type": "string",
            "minLength": 1
          },
          "entityId": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifactId",
          "entityId"
        ],
        "properties": {
          "artifactId": {
            "type": "string",
            "minLength": 1
          },
          "entityId": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "openDecisionIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "workspaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "workspaceKey",
          "artifactType",
          "availability"
        ],
        "properties": {
          "workspaceKey": {
            "type": "string",
            "minLength": 1
          },
          "artifactType": {
            "$ref": "https://nexus.local/schemas/common/artifact-type.v1.schema.json"
          },
          "availability": {
            "type": "string",
            "enum": [
              "artifact-available",
              "planned"
            ]
          }
        }
      },
      "minItems": 1
    },
    "verificationObjectives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "objectiveId",
          "requirementId",
          "workspaceKey",
          "method",
          "acceptanceCriteria"
        ],
        "properties": {
          "objectiveId": {
            "type": "string",
            "minLength": 1
          },
          "requirementId": {
            "type": "string",
            "minLength": 1
          },
          "workspaceKey": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "acceptanceCriteria": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "minItems": 1
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stepId",
          "title",
          "dependsOn",
          "workspaceKeys",
          "objectiveIds",
          "requiresApproval"
        ],
        "properties": {
          "stepId": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "workspaceKeys": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "objectiveIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "requiresApproval": {
            "const": true,
            "type": "boolean"
          }
        }
      },
      "minItems": 1
    }
  },
  "description": "Initialization review proposal pinned to source revisions; workspace keys are plan-local targets, not runtime workspace IDs."
}
