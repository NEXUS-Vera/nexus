{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/schemas/board-update.v1.schema.json",
  "title": "BoardUpdate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "boardId", "operation", "actorAgent"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "boardId": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "type": "string",
      "enum": ["create", "update", "move", "close", "comment"]
    },
    "actorAgent": {
      "type": "string",
      "minLength": 1
    },
    "itemId": {
      "type": "string"
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
