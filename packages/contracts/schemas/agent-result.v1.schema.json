{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/schemas/agent-result.v1.schema.json",
  "title": "AgentResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "agentId", "status"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "agentId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["success", "failure", "partial", "rejected"]
    },
    "summary": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifactId", "kind"],
        "properties": {
          "artifactId": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "uri": { "type": "string" }
        }
      }
    }
  }
}
