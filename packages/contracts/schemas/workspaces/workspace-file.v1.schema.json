{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/schemas/workspaces/workspace-file.v1.schema.json",
  "title": "WorkspaceFile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workspaceId",
    "path",
    "contentHash",
    "contentReference",
    "sizeBytes",
    "origin",
    "writePolicy",
    "modifiedByUser",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "workspaceId": {
      "type": "string",
      "pattern": "^ws_[A-Za-z0-9]{16,}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "description": "Normalized relative workspace path using '/' separators."
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "contentReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Opaque content-addressed blob reference; never a host filesystem path."
    },
    "sizeBytes": {
      "type": "integer",
      "minimum": 0
    },
    "origin": {
      "type": "string",
      "enum": [
        "USER",
        "GENERATED",
        "SYSTEM",
        "RUNTIME_OUTPUT"
      ]
    },
    "writePolicy": {
      "type": "string",
      "enum": [
        "USER_EDITABLE",
        "REGENERATION_MANAGED",
        "READ_ONLY",
        "EPHEMERAL"
      ]
    },
    "modifiedByUser": {
      "type": "boolean"
    },
    "generatedFrom": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "mediaType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedBy": {
      "$ref": "https://nexus.local/schemas/common/actor-reference.v1.schema.json"
    }
  }
}
