{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/schemas/workspaces/workspace-snapshot.v1.schema.json",
  "title": "WorkspaceSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "snapshotId",
    "workspaceId",
    "projectId",
    "artifactId",
    "snapshotVersion",
    "baseArtifactVersion",
    "baseProjectStateVersion",
    "content",
    "contentDigest",
    "createdBy",
    "createdAt",
    "reason"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "snapshotId": {
      "type": "string",
      "pattern": "^snap_[A-Za-z0-9]{16,}$"
    },
    "workspaceId": {
      "type": "string",
      "pattern": "^ws_[A-Za-z0-9]{16,}$"
    },
    "projectId": {
      "type": "string",
      "pattern": "^proj_[A-Za-z0-9]{16,}$"
    },
    "artifactId": {
      "type": "string",
      "pattern": "^art_[A-Za-z0-9]{16,}$"
    },
    "snapshotVersion": {
      "type": "integer",
      "minimum": 1
    },
    "baseArtifactVersion": {
      "type": "integer",
      "minimum": 1
    },
    "baseProjectStateVersion": {
      "type": "integer",
      "minimum": 1
    },
    "content": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "structuredContent"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "const": "structured"
            },
            "structuredContent": {
              "type": "object"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "filesystemManifest"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "const": "filesystem"
            },
            "filesystemManifest": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "manifestDigest",
                "entries"
              ],
              "properties": {
                "manifestDigest": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "entries": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "path",
                      "contentHash",
                      "contentReference",
                      "sizeBytes",
                      "origin",
                      "writePolicy",
                      "modifiedByUser"
                    ],
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1024
                      },
                      "contentHash": {
                        "type": "string",
                        "pattern": "^sha256:[a-f0-9]{64}$"
                      },
                      "contentReference": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "sizeBytes": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "origin": {
                        "type": "string",
                        "enum": [
                          "USER",
                          "GENERATED",
                          "SYSTEM",
                          "RUNTIME_OUTPUT"
                        ]
                      },
                      "writePolicy": {
                        "type": "string",
                        "enum": [
                          "USER_EDITABLE",
                          "REGENERATION_MANAGED",
                          "READ_ONLY",
                          "EPHEMERAL"
                        ]
                      },
                      "modifiedByUser": {
                        "type": "boolean"
                      },
                      "generatedFrom": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "mediaType": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "storageKind",
            "uri",
            "contentDigest"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "const": "storage-reference"
            },
            "storageKind": {
              "type": "string",
              "enum": [
                "postgres-jsonb",
                "object-store",
                "file-store"
              ]
            },
            "uri": {
              "type": "string",
              "minLength": 1
            },
            "contentDigest": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "contentDigest": {
      "type": "string",
      "minLength": 1
    },
    "createdBy": {
      "$ref": "https://nexus.local/schemas/common/actor-reference.v1.schema.json"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  }
}
