{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/schemas/executions/execution-run.v1.schema.json",
  "title": "ExecutionRun",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "executionRunId",
    "executionRequestId",
    "projectId",
    "providerId",
    "capability",
    "status",
    "baseArtifactVersion",
    "baseProjectStateVersion",
    "inputSnapshotId",
    "startedAt",
    "outputReferences",
    "evidenceReferences"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "executionRunId": {
      "type": "string",
      "pattern": "^exec_[A-Za-z0-9]{16,}$"
    },
    "executionRequestId": {
      "type": "string",
      "pattern": "^execreq_[A-Za-z0-9]{16,}$"
    },
    "projectId": {
      "type": "string",
      "pattern": "^proj_[A-Za-z0-9]{16,}$"
    },
    "artifactId": {
      "type": "string",
      "pattern": "^art_[A-Za-z0-9]{16,}$"
    },
    "workspaceId": {
      "type": "string",
      "pattern": "^ws_[A-Za-z0-9]{16,}$"
    },
    "providerId": {
      "type": "string",
      "minLength": 1
    },
    "capability": {
      "type": "string",
      "enum": [
        "structured-validation",
        "fake-execution",
        "file-workspace",
        "sandbox-execution",
        "embedded-build",
        "python-kernel",
        "circuit-simulation",
        "architecture-export"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "starting",
        "running",
        "completed",
        "completed-with-warnings",
        "failed",
        "cancelled",
        "timed-out",
        "stale"
      ]
    },
    "baseArtifactVersion": {
      "type": "integer",
      "minimum": 1
    },
    "baseProjectStateVersion": {
      "type": "integer",
      "minimum": 1
    },
    "inputSnapshotId": {
      "type": "string",
      "pattern": "^snap_[A-Za-z0-9]{16,}$"
    },
    "executionJobId": {
      "type": "string",
      "pattern": "^execjob_[A-Za-z0-9]{16,}$",
      "description": "Optional infrastructure job id for Nexus-owned sandboxed execution."
    },
    "runtimeIdentity": {
      "type": "object",
      "additionalProperties": false,
      "description": "Runtime fingerprint recorded for job-backed executions.",
      "required": [
        "runtimeKind",
        "runtimeVersion",
        "workspaceSnapshotId",
        "workspaceManifestDigest",
        "commandSpecVersion",
        "limits"
      ],
      "properties": {
        "runtimeKind": {
          "type": "string",
          "enum": [
            "process",
            "container"
          ]
        },
        "runtimeVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "workspaceSnapshotId": {
          "type": "string",
          "pattern": "^snap_[A-Za-z0-9]{16,}$"
        },
        "workspaceManifestDigest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "commandSpecVersion": {
          "type": "string",
          "const": "1.0.0"
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "wallTimeMs",
            "stdoutBytes",
            "stderrBytes",
            "totalLogBytes",
            "producedOutputBytes",
            "outputFileCount",
            "workspaceBytes"
          ],
          "properties": {
            "wallTimeMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300000
            },
            "stdoutBytes": {
              "type": "integer",
              "minimum": 1
            },
            "stderrBytes": {
              "type": "integer",
              "minimum": 1
            },
            "totalLogBytes": {
              "type": "integer",
              "minimum": 1
            },
            "producedOutputBytes": {
              "type": "integer",
              "minimum": 1
            },
            "outputFileCount": {
              "type": "integer",
              "minimum": 1
            },
            "workspaceBytes": {
              "type": "integer",
              "minimum": 1
            },
            "memoryBytes": {
              "type": "integer",
              "minimum": 1
            },
            "cpuMillis": {
              "type": "integer",
              "minimum": 1
            },
            "processCount": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "imageReference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "imageDigest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "executableFingerprint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "isolationGuarantees": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "isolationLimitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "securityLevel": {
          "type": "string",
          "enum": [
            "limited",
            "isolated"
          ]
        },
        "networkPolicy": {
          "type": "string",
          "enum": [
            "none",
            "restricted"
          ]
        }
      }
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "outputReferences": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^out_[A-Za-z0-9]{16,}$"
      }
    },
    "evidenceReferences": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "logReference": {
      "type": "string",
      "pattern": "^out_[A-Za-z0-9]{16,}$"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "cleanupWarning": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Infrastructure cleanup warning after a successful or terminal run."
    }
  }
}
