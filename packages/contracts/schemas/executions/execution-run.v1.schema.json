{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/schemas/executions/execution-run.v1.schema.json",
  "title": "ExecutionRun",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "executionRunId",
    "executionRequestId",
    "projectId",
    "providerId",
    "capability",
    "status",
    "baseArtifactVersion",
    "baseProjectStateVersion",
    "inputSnapshotId",
    "startedAt",
    "outputReferences",
    "evidenceReferences"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "executionRunId": {
      "type": "string",
      "pattern": "^exec_[A-Za-z0-9]{16,}$"
    },
    "executionRequestId": {
      "type": "string",
      "pattern": "^execreq_[A-Za-z0-9]{16,}$"
    },
    "projectId": {
      "type": "string",
      "pattern": "^proj_[A-Za-z0-9]{16,}$"
    },
    "artifactId": {
      "type": "string",
      "pattern": "^art_[A-Za-z0-9]{16,}$"
    },
    "workspaceId": {
      "type": "string",
      "pattern": "^ws_[A-Za-z0-9]{16,}$"
    },
    "providerId": {
      "type": "string",
      "minLength": 1
    },
    "capability": {
      "type": "string",
      "enum": [
        "structured-validation",
        "fake-execution",
        "file-workspace",
        "embedded-build",
        "python-kernel",
        "circuit-simulation",
        "architecture-export"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "starting",
        "running",
        "completed",
        "completed-with-warnings",
        "failed",
        "cancelled",
        "timed-out",
        "stale"
      ]
    },
    "baseArtifactVersion": {
      "type": "integer",
      "minimum": 1
    },
    "baseProjectStateVersion": {
      "type": "integer",
      "minimum": 1
    },
    "inputSnapshotId": {
      "type": "string",
      "pattern": "^snap_[A-Za-z0-9]{16,}$"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "outputReferences": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^out_[A-Za-z0-9]{16,}$"
      }
    },
    "evidenceReferences": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "logReference": {
      "type": "string",
      "pattern": "^out_[A-Za-z0-9]{16,}$"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
