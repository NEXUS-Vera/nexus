{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/schemas/executions/execution-request.v1.schema.json",
  "title": "ExecutionRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "executionRequestId",
    "projectId",
    "artifactId",
    "workspaceId",
    "snapshotId",
    "capability",
    "requestedBy",
    "resourceLimits",
    "requestedAt"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "executionRequestId": {
      "type": "string",
      "pattern": "^execreq_[A-Za-z0-9]{16,}$"
    },
    "projectId": {
      "type": "string",
      "pattern": "^proj_[A-Za-z0-9]{16,}$"
    },
    "artifactId": {
      "type": "string",
      "pattern": "^art_[A-Za-z0-9]{16,}$"
    },
    "workspaceId": {
      "type": "string",
      "pattern": "^ws_[A-Za-z0-9]{16,}$"
    },
    "snapshotId": {
      "type": "string",
      "pattern": "^snap_[A-Za-z0-9]{16,}$"
    },
    "capability": {
      "type": "string",
      "enum": [
        "structured-validation",
        "fake-execution",
        "file-workspace",
        "sandbox-execution",
        "embedded-build",
        "python-kernel",
        "circuit-simulation",
        "architecture-export"
      ]
    },
    "requestedBy": {
      "$ref": "https://nexus.local/schemas/common/actor-reference.v1.schema.json"
    },
    "resourceLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxDurationMs"
      ],
      "properties": {
        "maxDurationMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300000
        },
        "maxOutputBytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "requestedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
