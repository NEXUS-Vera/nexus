# Example environment variables for local development.
# Copy to .env and fill in values. Never commit .env.
# No secrets belong in this file.

NEXUS_ENV=local

# Embedded-systems project-initialization workflow.
# Provider mode: fixture (deterministic, default, no model calls), llm (live
# staged generation), or shadow (runs both, returns fixture, logs LLM outcome).
NEXUS_INITIALIZATION_PROVIDER=fixture
NEXUS_MODEL_PROVIDER=openai
NEXUS_MODEL_NAME=gpt-4.1-mini
NEXUS_MODEL_API_KEY=
NEXUS_MODEL_TIMEOUT_SECONDS=60
NEXUS_MODEL_MAX_REPAIR_ATTEMPTS=1
