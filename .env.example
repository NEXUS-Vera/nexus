# Example environment variables for local development.
# Copy to .env and fill in values. Never commit .env.
# No secrets belong in this file.

NEXUS_ENV=local

# Storage: memory (tests/default), sqlite (what the packaged desktop shell
# runs), or postgres (local visible demo). NEXUS_DATABASE_URL carries the URL
# for both sqlite (sqlite:///<absolute-path>) and postgres.
NEXUS_STORAGE_BACKEND=memory
NEXUS_DATABASE_URL=postgresql+psycopg://nexus:nexus@localhost:5432/nexus
# Explicit allowlist of browser origins. The default depends on the token
# below: with a real secret set, any origin is allowed (a packaged renderer
# sends Origin: null, which no allowlist contains); with the token left unset
# it is published, so the default narrows to the Vite dev server on
# http://localhost:5173 and http://127.0.0.1:5173. Serving the web app from any
# other port means naming that origin here.
NEXUS_API_CORS_ORIGINS=

# Bearer token required on every API request, and the real security boundary.
# The desktop shell generates a fresh value per launch; leave unset locally to
# use the published development default.
NEXUS_API_SESSION_TOKEN=

# Embedded-systems project-initialization workflow.
# Provider mode: fixture (deterministic, default, no model calls), llm (live
# staged generation), or shadow (runs both, returns fixture, logs LLM outcome).
NEXUS_INITIALIZATION_PROVIDER=fixture
# Model gateway: openai (default) or anthropic.
# For Anthropic: NEXUS_MODEL_PROVIDER=anthropic,
# NEXUS_MODEL_NAME=claude-sonnet-4-6,
# NEXUS_MODEL_BASE_URL=https://api.anthropic.com
NEXUS_MODEL_PROVIDER=openai
NEXUS_MODEL_NAME=gpt-4.1-mini
NEXUS_MODEL_API_KEY=
NEXUS_MODEL_TIMEOUT_SECONDS=60
NEXUS_MODEL_MAX_REPAIR_ATTEMPTS=1

# Optional local Wokwi CLI smoke test. The CLI and firmware are user-provided.
RUN_WOKWI_INTEGRATION=0
WOKWI_CLI_TOKEN=
NEXUS_WOKWI_FIRMWARE_ELF=
