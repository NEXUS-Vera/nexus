# Example environment variables for local development.
# Copy to .env and fill in values. Never commit .env.
# No secrets belong in this file.

NEXUS_ENV=local

# Storage: memory (tests/default) or postgres (local visible demo).
NEXUS_STORAGE_BACKEND=memory
NEXUS_DATABASE_URL=postgresql+psycopg://nexus:nexus@localhost:5432/nexus
NEXUS_API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Embedded-systems project-initialization workflow.
# Provider mode: fixture (deterministic, default, no model calls), llm (live
# staged generation), or shadow (runs both, returns fixture, logs LLM outcome).
NEXUS_INITIALIZATION_PROVIDER=fixture
# Model gateway: openai (default) or anthropic.
# For Anthropic: NEXUS_MODEL_PROVIDER=anthropic,
# NEXUS_MODEL_NAME=claude-sonnet-4-6,
# NEXUS_MODEL_BASE_URL=https://api.anthropic.com
NEXUS_MODEL_PROVIDER=openai
NEXUS_MODEL_NAME=gpt-4.1-mini
NEXUS_MODEL_API_KEY=
NEXUS_MODEL_TIMEOUT_SECONDS=60
NEXUS_MODEL_MAX_REPAIR_ATTEMPTS=1

# Optional local Wokwi CLI smoke test. The CLI and firmware are user-provided.
RUN_WOKWI_INTEGRATION=0
WOKWI_CLI_TOKEN=
NEXUS_WOKWI_FIRMWARE_ELF=

# Phase 14A filesystem workspace store (optional). When unset, the API uses an
# in-memory content-addressed blob store. Set a local directory for durable blobs.
# NEXUS_FILE_STORE_ROOT=/tmp/nexus-file-store
# NEXUS_WORKSPACE_MAX_FILE_BYTES=1048576
# NEXUS_WORKSPACE_MAX_BYTES=16777216
# NEXUS_WORKSPACE_MAX_FILE_COUNT=256

# Phase 14B sandboxed execution capacity/limits (optional).
# NEXUS_EXEC_MAX_RUNNING_GLOBAL=2
# NEXUS_EXEC_MAX_RUNNING_PER_PROJECT=1
# NEXUS_EXEC_MAX_QUEUED=32
# NEXUS_EXEC_WALL_TIME_MS=30000
# NEXUS_EXEC_STDOUT_BYTES=1048576
# NEXUS_EXEC_STDERR_BYTES=1048576
# NEXUS_EXEC_TOTAL_LOG_BYTES=2097152
# NEXUS_EXEC_PRODUCED_OUTPUT_BYTES=4194304

# Phase 14C runtime hardening (optional).
# Explicit runtime selection — never silently downgrades.
# NEXUS_EXECUTION_RUNTIME=process
# NEXUS_EXECUTION_RUNTIME=container
# NEXUS_EXEC_CONTAINER_IMAGE=python:3.13-slim
# Phase 15E firmware toolchain image (offline PlatformIO ESP32):
# NEXUS_EXEC_CONTAINER_IMAGE=nexus-firmware-platformio-esp32:1.0.0
# NEXUS_FIRMWARE_USE_STUB=1
# Phase 16G Analysis scientific Python image (offline numpy/pandas/matplotlib):
# NEXUS_EXEC_CONTAINER_IMAGE=nexus-python-analysis:1.0.0
# NEXUS_ANALYSIS_USE_STUB=1
# Opt-in live Analysis gates (not part of ordinary make check):
# RUN_ANALYSIS_LLM_INTEGRATION=1
# RUN_ANALYSIS_DOCKER_INTEGRATION=1
# RUN_ANALYSIS_FULL_LIVE=1
# NEXUS_EXEC_DOCKER=docker
# NEXUS_EXEC_MEMORY_BYTES=268435456
# NEXUS_EXEC_CPU_MILLIS=1000
# NEXUS_EXEC_PROCESS_COUNT=64
# Opt-in Docker integration tests (not part of ordinary make check):
# RUN_DOCKER_INTEGRATION=1
# Retention / GC (dev defaults; reference safety always overrides):
# NEXUS_RETENTION_SNAPSHOT_MAX_AGE_SECONDS=604800
# NEXUS_RETENTION_LOG_MAX_AGE_SECONDS=604800
# NEXUS_RETENTION_MAX_RECLAIM_BLOBS=
# NEXUS_RETENTION_MAX_RECLAIM_SNAPSHOTS=
