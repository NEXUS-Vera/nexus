# Example environment variables for local development.
# Copy to .env and fill in values. Never commit .env.
# No secrets belong in this file.

NEXUS_ENV=local

# Storage: memory (tests/default) or postgres (local visible demo).
NEXUS_STORAGE_BACKEND=memory
NEXUS_DATABASE_URL=postgresql+psycopg://nexus:nexus@localhost:5432/nexus
# Optional development-only narrowing of browser origins. Unset means any
# origin; the session token below is the real security boundary.
NEXUS_API_CORS_ORIGINS=

# Bearer token required on every API request. The desktop shell generates a
# fresh value per launch; leave unset locally to use the development default.
NEXUS_API_SESSION_TOKEN=

# Embedded-systems project-initialization workflow.
# Provider mode: fixture (deterministic, default, no model calls), llm (live
# staged generation), or shadow (runs both, returns fixture, logs LLM outcome).
NEXUS_INITIALIZATION_PROVIDER=fixture
# Model gateway: openai (default) or anthropic.
# For Anthropic: NEXUS_MODEL_PROVIDER=anthropic,
# NEXUS_MODEL_NAME=claude-sonnet-4-6,
# NEXUS_MODEL_BASE_URL=https://api.anthropic.com
NEXUS_MODEL_PROVIDER=openai
NEXUS_MODEL_NAME=gpt-4.1-mini
NEXUS_MODEL_API_KEY=
NEXUS_MODEL_TIMEOUT_SECONDS=60
NEXUS_MODEL_MAX_REPAIR_ATTEMPTS=1
