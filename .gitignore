# Agent tooling scratch. The Claude harness creates git worktrees under
# .claude/worktrees/, which land in the index as gitlinks with no submodule
# behind them and break `git clone --recurse-submodules` for everyone else.
# Only the checked-in settings file belongs in the repository.
.claude/*
!.claude/settings.json

# IDE / OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Package manager locks (keep intentional lockfiles; ignore accidental local ones)
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

